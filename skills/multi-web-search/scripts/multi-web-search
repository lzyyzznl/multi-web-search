#!/usr/bin/env bash
# multi-web-search 启动器：按当前平台从 GitHub Releases 拉取对应二进制并执行。
# 二进制不随仓库(技能)分发——分发单元是 git，不能绑死单平台；平台差异在安装时解决。
#
# 环境变量：
#   MULTI_WEB_SEARCH_VERSION  固定版本(tag，如 v1.0.0)，默认 latest
#   MULTI_WEB_SEARCH_BIN      本地二进制路径，跳过下载（源码开发/离线场景）
set -euo pipefail

REPO="lzyyzznl/multi-web-search"
VER="${MULTI_WEB_SEARCH_VERSION:-latest}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/multi-web-search"

# 本地二进制直通（开发/离线/无 release 兜底）
if [ -n "${MULTI_WEB_SEARCH_BIN:-}" ]; then
  exec "$MULTI_WEB_SEARCH_BIN" "$@"
fi

case "$(uname -s)" in
  Linux)  os="linux" ;;
  Darwin) os="darwin" ;;
  *) echo "multi-web-search: 不支持的平台: $(uname -s)（Windows 请用 git-bash/WSL 或源码构建）" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64|amd64)  arch="amd64" ;;
  aarch64|arm64) arch="arm64" ;;
  *) echo "multi-web-search: 不支持的架构: $(uname -m)" >&2; exit 1 ;;
esac

asset="multi-web-search-${os}-${arch}"
LATEST_BASE="https://github.com/$REPO/releases/latest/download"

# latest 解析为具体 tag：绕开 api.github.com（企业代理常拦截），HEAD 跟随 latest 重定向取实际版本
if [ "$VER" = "latest" ]; then
  VER="$(curl -sI -o /dev/null -w '%{redirect_url}' "$LATEST_BASE/$asset" \
    | sed -n 's#.*/releases/download/\([^/]*\)/.*#\1#p')"
fi

# 解析失败时 VER 为空，回退为 latest 整体跟随下载
if [ -n "$VER" ]; then
  dl_url="https://github.com/$REPO/releases/download/$VER/$asset"
else
  VER="latest"
  dl_url="$LATEST_BASE/$asset"
fi

bin="$CACHE/$VER/$asset"
if [ ! -x "$bin" ]; then
  mkdir -p "$(dirname "$bin")"
  tmp="${bin}.$$"
  echo "multi-web-search: 下载 $REPO@$VER ($os/$arch) ..." >&2
  curl -fL --retry 3 -o "$tmp" "$dl_url"
  chmod +x "$tmp"
  mv "$tmp" "$bin"
fi
exec "$bin" "$@"
